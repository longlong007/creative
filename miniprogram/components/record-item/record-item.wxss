.row {
  display: flex;
  align-items: center;
  padding: 22rpx 12rpx;
  margin: 0 -4rpx;
  gap: 20rpx;
  border-radius: 20rpx;
  transition: background-color 0.15s ease, transform 0.15s ease;
}

.row.pressed {
  background: #E8DFD4;
  transform: scale(0.97);
}

.row.open .title {
  color: #6B86B3;
}

.dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dot-inner {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 30rpx;
  font-weight: 560;
}

.meta {
  font-size: 22rpx;
  color: #8A8178;
  margin-top: 4rpx;
}

.time {
  font-size: 24rpx;
  color: #8A8178;
  flex-shrink: 0;
}
