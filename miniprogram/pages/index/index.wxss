.page {
  padding: 24rpx 28rpx 40rpx;
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.baby {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  background: #E07A5F;
}

.avatar.boy {
  background: #6B86B3;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 12rpx;
}

.age {
  font-size: 24rpx;
  color: #8A8178;
}

.hint {
  font-size: 22rpx;
  color: #8A8178;
}

.insight {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #2C2622;
  color: #fff;
  font-size: 24rpx;
}

.sleep-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #6B86B3;
  color: #fff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.sleep-k {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
}

.sleep-v {
  font-size: 36rpx;
  font-weight: 700;
}

.wake-btn {
  background: rgba(255, 255, 255, 0.2);
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
}

.stats {
  display: flex;
  padding: 28rpx 12rpx;
  margin-bottom: 16rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-v {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.stat-k {
  font-size: 22rpx;
  color: #8A8178;
}

.last {
  text-align: center;
  color: #8A8178;
  font-size: 24rpx;
  margin: 8rpx 0 24rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.q {
  height: 180rpx;
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #2C2622;
}

.q-k {
  font-size: 40rpx;
  font-weight: 750;
}

.q-s {
  font-size: 22rpx;
  opacity: 0.72;
}

.q.milk { background: #FBE4DC; }
.q.sleep { background: #E4EAF4; }
.q.sleep.on { background: #6B86B3; color: #fff; }
.q.pee { background: #E3F0EA; }
.q.poop { background: #F3EBDD; }

.more-link {
  text-align: center;
  color: #8A8178;
  font-size: 24rpx;
  padding: 12rpx 0 28rpx;
}

.recent-card {
  padding: 24rpx 28rpx 12rpx;
}

.empty {
  text-align: center;
  color: #8A8178;
  padding: 40rpx 0 48rpx;
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin: 28rpx 0 16rpx;
}

.amt {
  height: 88rpx;
  border-radius: 24rpx;
  background: #F3EEE7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.amt.on {
  background: #E07A5F;
  color: #fff;
}

.amt-input {
  height: 88rpx;
  background: #F7F1EA;
  border-radius: 24rpx;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
}

.time-row {
  margin-bottom: 24rpx;
}

.save {
  margin-top: 8rpx;
}

.more-list {
  display: flex;
  flex-direction: column;
}

.more-item {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid #F0E8DE;
}

.more-n {
  font-size: 32rpx;
  font-weight: 600;
}

.more-d {
  color: #8A8178;
}
