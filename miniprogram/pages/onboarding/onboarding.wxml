<view class="page">
  <view wx:if="{{step === 'hello'}}" class="hero">
    <view class="mark">芽</view>
    <view class="title">小芽记</view>
    <view class="sub">一家人，轻松记下宝宝的身高体重、奶量和睡眠。</view>
    <view class="points">
      <text>喝奶、睡觉、尿布，点一下就记下</text>
      <text>爸爸妈妈共用一本账</text>
      <text>数据整齐，以后可以交给 AI 看趋势</text>
    </view>
    <button class="btn btn-primary" bindtap="goCreate">给宝宝建一本</button>
    <button class="btn btn-ghost" bindtap="goJoin">我有邀请码</button>
  </view>

  <view wx:else class="form">
    <view class="title">宝宝叫什么？</view>
    <input class="input" placeholder="小名即可" value="{{babyName}}" bindinput="onName" maxlength="12" />
    <view class="label">性别</view>
    <view class="chip-row">
      <view class="chip {{gender === 'girl' ? 'on' : ''}}" data-g="girl" bindtap="onGender">女孩</view>
      <view class="chip {{gender === 'boy' ? 'on' : ''}}" data-g="boy" bindtap="onGender">男孩</view>
      <view class="chip {{gender === 'unknown' ? 'on' : ''}}" data-g="unknown" bindtap="onGender">先不填</view>
    </view>
    <view class="label">生日</view>
    <picker mode="date" value="{{birthday}}" bindchange="onBirth">
      <view class="input picker">{{birthday}}</view>
    </picker>
    <button class="btn btn-primary" bindtap="submit">开始记录</button>
  </view>
</view>
