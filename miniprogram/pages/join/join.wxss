.page {
  padding: 80rpx 48rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 750;
  margin-bottom: 16rpx;
}

.sub {
  color: #8A8178;
  margin-bottom: 48rpx;
}

.label {
  color: #8A8178;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.input {
  height: 108rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.input.nick {
  text-align: left;
  font-size: 32rpx;
}

.input.code {
  text-align: center;
  letter-spacing: 8rpx;
  font-size: 40rpx;
}
