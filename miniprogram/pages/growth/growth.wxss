.page {
  padding: 24rpx 28rpx 0;
}

.hero {
  display: flex;
  padding: 36rpx 12rpx;
  margin-bottom: 24rpx;
}

.metric {
  flex: 1;
  text-align: center;
}

.k {
  display: block;
  color: #8A8178;
  font-size: 24rpx;
}

.v {
  display: block;
  font-size: 44rpx;
  font-weight: 760;
  margin: 8rpx 0;
}

.when {
  font-size: 22rpx;
  color: #8A8178;
}

.split {
  width: 1rpx;
  background: #EDE4D8;
}

.chart-card {
  margin: 20rpx 0;
  padding: 16rpx;
}

.chart {
  width: 100%;
  height: 360rpx;
}

.add {
  margin: 8rpx 0 28rpx;
}

.list {
  padding: 24rpx 28rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0E8DE;
}

.empty {
  text-align: center;
  color: #8A8178;
  padding: 24rpx 0;
}

.amt-input {
  height: 88rpx;
  background: #F7F1EA;
  border-radius: 24rpx;
  padding: 0 28rpx;
  margin: 20rpx 0 24rpx;
}
