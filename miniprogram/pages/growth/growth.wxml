<view class="page safe-bottom">
  <view class="hero card">
    <view class="metric" bindtap="openAdd" data-type="weight">
      <text class="k">体重</text>
      <text class="v">{{weightText}}</text>
      <text class="when">{{weightWhen}}</text>
    </view>
    <view class="split"></view>
    <view class="metric" bindtap="openAdd" data-type="height">
      <text class="k">身高</text>
      <text class="v">{{heightText}}</text>
      <text class="when">{{heightWhen}}</text>
    </view>
  </view>

  <view class="chip-row">
    <view class="chip {{tab === 'weight' ? 'on' : ''}}" data-tab="weight" bindtap="setTab">体重曲线</view>
    <view class="chip {{tab === 'height' ? 'on' : ''}}" data-tab="height" bindtap="setTab">身高曲线</view>
  </view>

  <view class="card chart-card">
    <canvas type="2d" id="chart" class="chart"></canvas>
  </view>

  <button class="btn btn-primary add" bindtap="openAdd" data-type="{{tab}}">记一条{{tab === 'weight' ? '体重' : '身高'}}</button>

  <view class="card list">
    <view class="section-title">历史测量</view>
    <view wx:if="{{!series.length}}" class="empty">还没有测量</view>
    <view class="row" wx:for="{{series}}" wx:key="id" data-id="{{item.id}}" bindtap="editRecord">
      <text>{{item.v}}{{tab === 'weight' ? ' kg' : ' cm'}}</text>
      <text class="muted">{{item.tText}}</text>
    </view>
  </view>
  <view class="tab-space"></view>
</view>

<view class="mask" wx:if="{{sheet}}" bindtap="closeSheet"></view>
<view class="sheet {{sheet ? 'show' : ''}}" wx:if="{{sheet}}" catchtap="noop">
  <view class="sheet-handle"></view>
  <view class="sheet-title">记{{formType === 'weight' ? '体重' : '身高'}}</view>
  <view class="when-field">
    <text>日期</text>
    <picker mode="date" value="{{formDate}}" bindchange="onDate">
      <view>{{formDate}}</view>
    </picker>
  </view>
  <view class="when-field">
    <text>时间</text>
    <picker mode="time" value="{{formTime}}" bindchange="onTime">
      <view>{{formTime}}</view>
    </picker>
  </view>
  <input class="amt-input" type="digit" placeholder="{{formType === 'weight' ? '例如 8.2' : '例如 72.5'}}" bindinput="onValue" />
  <button class="btn btn-primary" bindtap="save">保存</button>
</view>
