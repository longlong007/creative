.page {
  padding: 24rpx 28rpx 0;
}

.identity-card,
.baby-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #E07A5F;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}

.avatar.identity {
  background: #8A8178;
}

.avatar.boy { background: #6B86B3; }

.name {
  font-size: 36rpx;
  font-weight: 700;
}

.meta { flex: 1; }

.edit { color: #8A8178; font-size: 24rpx; }

.block {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.code {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  text-align: center;
  margin: 8rpx 0 16rpx;
}

.small { font-size: 24rpx; line-height: 1.6; }

.row-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.mini {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
}

.ghost {
  background: #F3EEE7;
  color: #2C2622;
}

.member {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
}

.member.mine {
  color: #2C2622;
}

.link {
  color: #E07A5F;
  padding: 12rpx 0;
}

.danger-link {
  color: #B54A3A;
  padding: 20rpx 0 4rpx;
  font-size: 26rpx;
}

.guest-lead {
  margin: 8rpx 8rpx 40rpx;
  line-height: 1.6;
}

.guest-block .btn {
  margin-bottom: 16rpx;
}

.nick-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(44, 38, 34, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.nick-sheet {
  width: 100%;
  background: #F7F3EE;
  border-radius: 32rpx 32rpx 0 0;
  /* 自定义 tabBar 盖不住时也要留出菜单高度；打开时会 hideTabBar */
  padding: 40rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.nick-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.nick-input {
  height: 96rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 0 28rpx;
  margin-bottom: 28rpx;
}

.nick-actions {
  display: flex;
  gap: 16rpx;
}

.nick-btn {
  flex: 1;
}
