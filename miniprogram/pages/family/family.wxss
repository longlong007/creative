.page {
  padding: 24rpx 28rpx 40rpx;
}

.baby-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #E07A5F;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}

.avatar.boy { background: #6B86B3; }

.name {
  font-size: 36rpx;
  font-weight: 700;
}

.meta { flex: 1; }

.edit { color: #8A8178; font-size: 24rpx; }

.block {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.code {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  text-align: center;
  margin: 8rpx 0 16rpx;
}

.small { font-size: 24rpx; line-height: 1.6; }

.row-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.mini {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
}

.ghost {
  background: #F3EEE7;
  color: #2C2622;
}

.member {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
}

.link {
  color: #E07A5F;
  padding: 12rpx 0;
}
