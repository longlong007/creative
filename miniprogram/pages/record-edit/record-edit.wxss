.page {
  padding: 32rpx 28rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 750;
  margin-bottom: 24rpx;
}

.card {
  padding: 8rpx 28rpx;
  margin-bottom: 32rpx;
}

.field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #F0E8DE;
}

.field input {
  text-align: right;
}

.danger {
  margin-top: 16rpx;
  background: transparent;
  color: #C45C4A;
}
