<view class="bar" wx:if="{{!hidden}}">
  <view class="row">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="item {{selected === index ? 'on' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="icon {{item.icon}}"></view>
      <text>{{item.text}}</text>
    </view>
  </view>
</view>
